APP_ENV=testing
APP_KEY=
APP_DEBUG=true

# Base EXCLUSIVA para tests. RefreshDatabase la borra y recrea en cada corrida.
# Nunca usar DB_DATABASE=heavymarket aquí.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=heavymarket_test
DB_USERNAME=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql

SESSION_DRIVER=array
LOG_CHANNEL=stderr
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
