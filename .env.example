# Variables para docker-compose.yml (raíz del monorepo).
# Copiar a ".env" y ajustar. No versionar el ".env" real (ver .gitignore).

# Activa el servicio "mysql" del compose. Dejar vacío en el laptop (usa MySQL nativo).
# En un servidor sin MySQL nativo (ej. servidor de desarrollo 24/7): COMPOSE_PROFILES=server
COMPOSE_PROFILES=

MYSQL_ROOT_PASSWORD=cambia_esta_password
MYSQL_DATABASE=heavymarket
MYSQL_USER=heavymarket
MYSQL_PASSWORD=cambia_esta_password
